{
  "schema": 1,
  "kind": "charger",
  "vendor": "eveus",
  "variant": "current",
  "rev": 1,
  "model_hint": "Eveus Pro / Energy Star, current API (firmware R3.02.9 / R3.05.x)",
  "verified": false,
  "transport": { "type": "http", "port": 80, "auth": "basic" },
  "detect": {
    "probe": { "method": "GET", "path": "/main" },
    "all": [
      { "json": "verFWWifi", "exists": true },
      { "json": "currentSet", "exists": true }
    ],
    "none": []
  },
  "auth_check": { "method": "GET", "path": "/", "ok": [200], "bad": [401], "default_creds": [] },
  "ident": {
    "serial": ["serialNum", "stationId"],
    "fw": ["verFWMain", "verFWWifi"],
    "model": ["model"]
  },
  "poll": { "method": "GET", "path": "/main", "min_interval_ms": 1000 },
  "read": {
    "state": "state",
    "set_a": "currentSet",
    "meas_a": "curMeas1",
    "volt": "voltMeas1",
    "power_w": "powerMeas",
    "session_kwh": "sessionEnergy",
    "enabled": { "key": "evseEnabled", "invert": true }
  },
  "states": { "2": "A", "3": "B", "4": "C", "5": "B", "6": "B", "7": "E" },
  "quirks": { "skip_polls_after_write": 2, "single_connection": true }
}
