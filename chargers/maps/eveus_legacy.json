{
  "schema": 1,
  "kind": "charger",
  "vendor": "eveus",
  "variant": "legacy",
  "rev": 3,
  "model_hint": "Eveus / EnergyStar, pre-rebrand firmware EnergyStar V5.x (no verFW* in /main)",
  "verified": false,
  "transport": { "type": "http", "port": 80, "auth": "basic" },
  "detect": {
    "probe": { "method": "POST", "path": "/main" },
    "all": [
      { "json": "currentSet", "exists": true },
      { "json": "voltKoef1", "exists": true }
    ],
    "none": [
      { "json": "verFWWifi", "exists": true }
    ]
  },
  "auth_check": { "method": "GET", "path": "/", "ok": [200], "bad": [401], "default_creds": [] },
  "ident": {
    "serial": [],
    "fw": [],
    "model": []
  },
  "poll": { "method": "POST", "path": "/main", "min_interval_ms": 1000 },
  "read": {
    "state": "state",
    "set_a": "currentSet",
    "meas_a": { "key": "curMeas1", "scale": 0.1 },
    "volt": "voltMeas1",
    "session_kwh": { "key": "sessionEnergy", "scale": 0.1 },
    "temp_c": "temperature1",
    "enabled": { "key": "evseEnabled", "invert": false }
  },
  "states": {
    "12": "A", "9": "B", "13": "B", "6": "C",
    "14": "E", "15": "E", "16": "E", "17": "E", "18": "E",
    "19": "E", "20": "E", "21": "E", "22": "E"
  },
  "quirks": { "single_connection": true }
}
